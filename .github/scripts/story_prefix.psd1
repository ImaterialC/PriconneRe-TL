# Root hashtable mapping the leading digit of storydata_<digit>xxxxxx IDs
@{
    Prefixes = @{
        '0' = 'Main Story'
        '1' = 'Character Story'
        '2' = 'Event Story'
        '3' = 'Story (3xxxxxx)'
        '4' = 'Story (4xxxxxx)'
        '5' = 'Story (5xxxxxx)'
        '6' = 'Story (6xxxxxx)'
        '7' = 'Story (7xxxxxx)'
        '9' = 'Story (9xxxxxx)'
    }
}
